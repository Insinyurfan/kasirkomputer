{
  "name": "shinzi-computer-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.mjs && node scripts/prisma-generate.mjs",
    "build": "next build",
    "prestart": "node scripts/ensure-env.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "postinstall": "node scripts/prisma-generate.mjs",
    "setup": "node scripts/ensure-env.mjs && prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "set-password": "node scripts/set-password.mjs"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "html-to-image": "1.11.13",
    "next": "15.5.24",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "prisma": "6.16.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
